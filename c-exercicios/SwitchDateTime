using System;

class Program
{
    static void Main()
    {
        Console.WriteLine("Escolha o tamanho da camiseta:");
        Console.WriteLine("P - Pequena");
        Console.WriteLine("M - Média");
        Console.WriteLine("G - Grande");

        Console.Write("Digite o tamanho: ");
        char tamanho = char.ToUpper(char.Parse(Console.ReadLine()));

        switch (tamanho)
        {
            case 'P':
                Console.WriteLine("Camiseta P - R$ 30,00");
                break;

            case 'M':
                Console.WriteLine("Camiseta M - R$ 35,00");
                break;

            case 'G':
                Console.WriteLine("Camiseta G - R$ 40,00");
                break;

            default:
                Console.WriteLine("Tamanho inválido.");
                break;
        }
    }
}


